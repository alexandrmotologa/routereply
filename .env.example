# ==========================================
# RouteReply - Production Environment Config
# ==========================================

# 1. Telegram MTProto Credentials
# Obtain from https://my.telegram.org (API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_PHONE=

# Dispatch Mode: 'live' (sends real DMs to Telegram) or 'simulation' (verifies full pipeline offline)
DISPATCH_MODE=simulation

# 2. AI & LLM Engine
# Choose 'gemini', 'ollama', or 'deterministic'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama (zero cost, private, offline)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:latest

# 3. Safety & Anti-Ban Rate Limiting
# Randomized delay bounds between outbound DMs (in milliseconds)
MIN_DELAY_MS=90000
MAX_DELAY_MS=240000
MAX_DAILY_DMS=20
